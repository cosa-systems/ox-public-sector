#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

include /usr/share/cdbs/1/class/ant.mk
include /usr/share/cdbs/1/rules/debhelper.mk
include /usr/share/cdbs/1/rules/utils.mk

# Which distribution is this?
DIST_VERSION = $(shell lsb_release -sr)
OLD_DOCROOT_VERSIONS = "^6.*|^7.*|^12.04|^14.04|^14.10"
OLD_DOCROOT = $(shell echo $(DIST_VERSION) | egrep '$(OLD_DOCROOT_VERSIONS)')

# Choose new docroot path by empty OLD_DOCROOT var (bug 39797)
# No leading '/' because it will be used in *install files
ifeq "$(OLD_DOCROOT)" ""
    HTDOC := var/www/html
else
    HTDOC := var/www
endif

JAVA_HOME = $(shell readlink -f /usr/bin/javac | sed s:/bin/javac$$::)
DEB_ANT_ARGS = -DdestDir=$(DEB_DESTDIR) -Dhtdoc="/$(HTDOC)/" -DpackageName=$(DEB_SOURCE_PACKAGE) -DkeepCache=true
DEB_ANT_BUILDFILE = build/build.xml
DEB_ANT_INSTALL_TARGET = build

common-install-prehook-indep:: $(patsubst %,docroot-replace/%.install,$(DEB_ALL_PACKAGES)) docroot-replace/install
docroot-replace/%:
	echo "Changing @DOCROOT@ pattern within file $(CURDIR)/debian/$(@F) to $(HTDOC)"
	if [ -e $(CURDIR)/debian/$(@F) ]; then \
		sed -i "s:@DOCROOT@:$(HTDOC):g" $(CURDIR)/debian/$(@F); \
	fi
