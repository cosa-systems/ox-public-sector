{
  "name": "open-xchange-appsuite-public-sector",
  "version": "2.5.0",
  "license": "AGPL-3.0-or-later",
  "description": "UI customizations for the public sector",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --debug",
    "build": "vite build",
    "lint": "eslint --ext js,cjs,mjs src",
    "msgmerge": "for i in src/i18n/*.po; do msgmerge -Us --previous --backup=none \"$i\" dist/ox.pot; done",
    "serve": "vite preview",
    "test": "echo \"No tests to run\""
  },
  "devDependencies": {
    "@open-xchange/lint": "^0.0.2",
    "@open-xchange/rollup-plugin-po2json": "^0.7.1",
    "@open-xchange/vite-plugin-ox-css": "^0.0.1",
    "@open-xchange/vite-plugin-ox-externals": "^0.3.1",
    "@open-xchange/vite-plugin-ox-manifests": "^0.5.4",
    "@open-xchange/vite-plugin-proxy": "^0.6.3",
    "connect": "^3.7.0",
    "eslint": "^8.39.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "http-proxy": "^1.18.1",
    "otpauth": "^9.1.1",
    "rollup-plugin-copy": "^3.4.0",
    "sass": "^1.62.0",
    "vite": "^4.3.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": "eslint --cache --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "dependencies": {
    "dotenv-defaults": "^5.0.2"
  }
